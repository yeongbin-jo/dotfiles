#!/bin/sh
# macOS input preferences
# os: {{ .chezmoi.os }}
# scroll-direction: natural-off
# lock-password: immediate
# input-toggle: CapsLock -> F19 (Karabiner) -> "Select the previous input source" = 한/영 전환
set -e

{{- if eq .chezmoi.os "darwin" }}
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false
defaults write com.apple.screensaver askForPassword -int 1
defaults write com.apple.screensaver askForPasswordDelay -int 0
# 한/영 전환: Karabiner maps CapsLock->F19; here we bind macOS "Select the previous input
# source" (symbolic hotkey 60) to F19 (virtual keycode 80, no modifier). Toggles EN<->KO.
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 60 "<dict><key>enabled</key><true/><key>value</key><dict><key>type</key><string>standard</string><key>parameters</key><array><integer>65535</integer><integer>80</integer><integer>0</integer></array></dict></dict>"
killall cfprefsd >/dev/null 2>&1 || true
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u >/dev/null 2>&1 || true
echo "[macos-input] natural scroll off; lock immediate; input-source toggle -> F19 (CapsLock)"
{{- else }}
echo "[macos-input] skipped on non-darwin"
{{- end }}
