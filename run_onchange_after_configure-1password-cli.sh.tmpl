#!/bin/sh
# Configure 1Password CLI app integration for agent/non-interactive shells.
set -eu

ZSHENV="$HOME/.zshenv"
BEGIN="# >>> 1Password CLI app integration (chezmoi)"
END="# <<< 1Password CLI app integration (chezmoi)"

touch "$ZSHENV"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

awk -v begin="$BEGIN" -v end="$END" '
  $0 == begin { skip = 1; next }
  $0 == end { skip = 0; next }
  skip != 1 { print }
' "$ZSHENV" > "$TMP"

{
  cat "$TMP"
  printf '\n%s\n' "$BEGIN"
  printf '%s\n' 'export OP_BIOMETRIC_UNLOCK_ENABLED=true'
  printf '%s\n' "$END"
} > "$ZSHENV"

echo "[1password-cli] enabled desktop app integration in $ZSHENV"
