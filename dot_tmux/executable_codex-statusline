CACHE_TTL_SECONDS = 90
FETCH_TIMEOUT_SECONDS = 14
CONTEXT_TAIL_BYTES = 8 * 1024 * 1024
DEFAULT_CODEX_HOME = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
STATE_DB = DEFAULT_CODEX_HOME / "state_5.sqlite"
DEFAULT_CLAUDE_CONFIG_DIR = Path(
    os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")
)

# Claude Code keeps one account per CLAUDE_CONFIG_DIR, the same way codex keeps
# one per CODEX_HOME. Transcripts, context and the account label all live under
# the pane's own config dir, so reading the default home would answer for the
# wrong account.
ACTIVE_CLAUDE_CONFIG_DIR = DEFAULT_CLAUDE_CONFIG_DIR


def cache_dir() -> Path:
    root = os.environ.get("TMPDIR") or "/tmp"
    path = Path(root) / "codex-tmux-statusline"
    path.mkdir(parents=True, exist_ok=True)
    return path


# Weekly limits belong to an account, and codex keeps one account per CODEX_HOME.
# A single shared cache file would let whichever home refreshed last answer for
# every pane, so both the cache and its lock are keyed by home.
ACTIVE_CODEX_HOME = DEFAULT_CODEX_HOME


def home_slug(home: Path) -> str:
    return hashlib.sha1(str(home.resolve()).encode()).hexdigest()[:12]


def cache_file() -> Path:
    return cache_dir() / f"state-{home_slug(ACTIVE_CODEX_HOME)}.json"


def lock_file() -> Path:
    return cache_dir() / f"refresh-{home_slug(ACTIVE_CODEX_HOME)}.lock"


def read_cache() -> dict:
    try:
        return json.loads(cache_file().read_text())
    except Exception:
        return {}


def write_json(target: Path, state: dict) -> None:
    with tempfile.NamedTemporaryFile(mode="w", dir=target.parent, delete=False) as handle:
        tmp = Path(handle.name)
        json.dump(state, handle, separators=(",", ":"))
    try:
        os.replace(tmp, target)
    finally:
        tmp.unlink(missing_ok=True)


def write_cache(state: dict) -> None:
    write_json(cache_file(), state)


def acquire_lock() -> bool:
    try:
        fd = os.open(str(lock_file()), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        with os.fdopen(fd, "w") as f:
            f.write(str(os.getpid()))
        return True
    except FileExistsError:
        try:
            if time.time() - lock_file().stat().st_mtime > FETCH_TIMEOUT_SECONDS * 2:
                lock_file().unlink()
                return acquire_lock()
        except OSError:
            pass
        return False


def release_lock() -> None:
    try:
        lock_file().unlink()
    except FileNotFoundError:
        pass


def system_tool(name: str, *candidates: str) -> str:
    """Absolute path to a system tool.

    A tmux `#()` job inherits the PATH the tmux server started with. When that
    PATH is missing /bin the lookup raises, the caller swallows it, and every
    pane silently falls back to the default account — the wrong answer rather
    than a visible error. Name the locations instead.
    """
    for candidate in candidates:
        if Path(candidate).exists():
            return candidate
    return shutil.which(name) or name


PS = system_tool("ps", "/bin/ps", "/usr/bin/ps")
TMUX = system_tool("tmux", "/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux")
LSOF = system_tool("lsof", "/usr/sbin/lsof", "/usr/bin/lsof")


def codex_binary() -> str:
    # A tmux `#()` job inherits the tmux server's PATH, which was captured when
    # the server started and need not contain the install dir, so name the known
    # locations rather than trusting the lookup alone.
    found = shutil.which("codex")
    if found:
        return found
    for candidate in (Path.home() / ".local/bin/codex", Path("/opt/homebrew/bin/codex")):
        if candidate.exists():
            return str(candidate)
    return "codex"


def app_server_request() -> dict:
    # The status job inherits the tmux server environment, not the pane's, so the
    # home has to be named explicitly or every pane reports the default account.
    env = dict(os.environ, CODEX_HOME=str(ACTIVE_CODEX_HOME))
    proc = subprocess.Popen(
        [codex_binary(), "app-server", "--stdio"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        bufsize=0,
        env=env,
    )

    messages = [
        {
            "id": 0,
            "method": "initialize",
            "params": {
                "clientInfo": {
                    "name": "tmux_codex_status",
                    "title": "tmux Codex Status",
                    "version": "0.1.0",
                },
                "capabilities": {
                    "optOutNotificationMethods": [
                        "account/rateLimits/updated",
                        "remoteControl/status/changed",
                    ]
                },
            },
        },
        {"method": "initialized", "params": {}},
        {"id": 1, "method": "account/rateLimits/read"},
    ]

    assert proc.stdin is not None
    assert proc.stdout is not None

    for message in messages:
        proc.stdin.write((json.dumps(message, separators=(",", ":")) + "\n").encode())
    proc.stdin.flush()

    deadline = time.monotonic() + FETCH_TIMEOUT_SECONDS
    pending = b""
    try:
        while time.monotonic() < deadline:
            ready, _, _ = select.select([proc.stdout], [], [], max(0.0, deadline - time.monotonic()))
            if not ready:
                break
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                break
            pending += chunk
            while b"\n" in pending:
                line, pending = pending.split(b"\n", 1)
                payload = json.loads(line)
                if payload.get("id") == 1:
                    if "error" in payload:
                        raise RuntimeError(payload["error"].get("message", "rate limit request failed"))
                    return payload.get("result") or {}
        raise TimeoutError("timed out reading Codex rate limits")
    finally:
        try:
            proc.stdin.close()
        except Exception:
            pass
        proc.stdout.close()
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()


def clamp_percent(value) -> float:
    try:
        return min(100.0, max(0.0, float(value)))
    except Exception:
        return 0.0


def extract_state(result: dict) -> dict:
    limits_by_id = result.get("rateLimitsByLimitId") or {}
    limits = limits_by_id.get("codex") or result.get("rateLimits") or {}
    weekly = next((limits.get(name) for name in ("primary", "secondary")
                   if isinstance(limits.get(name), dict)
                   and limits[name].get("windowDurationMins") == 10080), None)
    if not weekly:
        raise RuntimeError("weekly limit window unavailable")

    reset_epoch = weekly.get("resetsAt")
    if not reset_epoch:
        raise RuntimeError("weekly reset timestamp unavailable")

    credits = result.get("rateLimitResetCredits") or {}
    credit_count = credits.get("availableCount")
    if not isinstance(credit_count, int):
        credit_count = 0

    used = weekly.get("usedPercent")
    if isinstance(used, bool) or not isinstance(used, (int, float)) or not math.isfinite(used) or not 0 <= used <= 100:
        raise RuntimeError("weekly usage unavailable")
    return {
        "remaining_percent": round(100.0 - used),
        "resets_at": int(reset_epoch),
        "reset_credits": credit_count,
        "fetched_at": int(time.time()),
        "error": None,
    }


def tmux_style(style: str, text: str) -> str:
    return f"#[{style}]{text}#[default]"


TMUX_STYLE_RE = re.compile(r"#\[[^\]]*\]")


def visible_width(text: str) -> int:
    plain = TMUX_STYLE_RE.sub("", text)
    width = 0
    for ch in plain:
        codepoint = ord(ch)
        if ch == "\ufe0f":
            continue
        if codepoint >= 0x1F300 or unicodedata.east_asian_width(ch) in ("W", "F"):
            width += 2
        else:
            width += 1
    return width


def countdown_text(seconds: int) -> str:
    if seconds <= 0:
        return "now"
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    minutes = rem // 60
    if days:
        return f"{days}d {hours:02}:{minutes:02}"
    return f"{hours:02}:{minutes:02}"


def is_codex_command(command: str | None) -> bool:
    if not command:
        return False
    return command == "codex" or command.startswith("codex-") or command.startswith("codex_")


def command_runs(command: str, needle: str) -> bool:
    """True when `command` launches the program `needle`.

    Match the program, never the whole command line: an opencode pane that runs
    /private/tmp/claude-501/.../x.sh is not a claude pane. The second token
    covers interpreter launches (node …/codex.js).
    """
    tokens = command.split(None, 2)[:2]
    if tokens and Path(tokens[0]).name not in ("node", "bun", "python", "python3"):
        tokens = tokens[:1]
    names = [os.path.basename(token) for token in tokens if not token.startswith("-")]
    return any(
        name == needle or name.startswith((needle + "-", needle + "_", needle + "."))
        for name in names
    )


_processes = None
_owner_bindings = {}
OWNER_TTL_SECONDS = 15


def process_snapshot() -> dict:
    global _processes
    if _processes is not None:
        return _processes
    try:
        result = subprocess.run([PS, "-axo", "pid=,ppid=,lstart=,command="],
                                capture_output=True, text=True, timeout=0.5, check=True,
                                env=dict(os.environ, LC_ALL="C"))
        rows = {}
        for line in result.stdout.splitlines():
            fields = line.split(None, 7)
            if len(fields) == 8:
                rows[int(fields[0])] = {"pid": int(fields[0]), "ppid": int(fields[1]),
                                       "started": " ".join(fields[2:7]), "command": fields[7]}
        _processes = rows
    except (OSError, ValueError, subprocess.SubprocessError):
        _processes = {}
    return _processes


def agent_kind(command: str) -> str | None:
    if not command:
        return None
    for tool in ("codex", "claude", "opencode", "agy"):
        if command_runs(command, tool):
            return tool
    if "/claude/versions/" in command.split(None, 1)[0]:
        return "claude"
    return None


def process_home(pid: int, tool: str) -> str | None:
    name = {"codex": "CODEX_HOME", "claude": "CLAUDE_CONFIG_DIR"}.get(tool)
    if not name:
        return ""
    try:
        if sys.platform.startswith("linux"):
            tokens = Path(f"/proc/{pid}/environ").read_bytes().decode().split("\0")
        else:
            result = subprocess.run([PS, "-Ewww", "-p", str(pid)], capture_output=True,
                                    text=True, timeout=0.3, check=True)
            match = re.search(r"(?:^|\s)" + name + r"=(.*?)(?= [A-Za-z_][A-Za-z0-9_]*=|$)", result.stdout.strip())
            tokens = [name + "=" + match.group(1)] if match else []
        value = next((t.split("=", 1)[1] for t in tokens if t.startswith(name + "=")), None)
        return value or str(Path.home() / (".codex" if tool == "codex" else ".claude"))
    except (OSError, UnicodeError, subprocess.SubprocessError):
        return None


def owner_for_pane(pane_pid: int | None, command: str = "") -> dict | None:
    if not pane_pid:
        return None
    if pane_pid in _owner_bindings:
        return _owner_bindings[pane_pid]
    path = cache_dir() / f"pane-{pane_pid}.json"
    try:
        cached = json.loads(path.read_text())
        if (cached.get("pid") is None and cached.get("pane_command") == command
                and time.time() - cached["checked_at"] < OWNER_TTL_SECONDS):
            _owner_bindings[pane_pid] = None
            return None
        os.kill(cached["pid"], 0)
        if time.time() - cached["checked_at"] < OWNER_TTL_SECONDS and (
                not agent_kind(command) or agent_kind(command) == cached["tool"]):
            _owner_bindings[pane_pid] = cached
            return cached
    except (OSError, ValueError, KeyError, TypeError):
        pass
    rows = process_snapshot()
    children = {}
    for row in rows.values():
        children.setdefault(row["ppid"], []).append(row["pid"])
    pending, seen = deque([pane_pid]), set()
    owner = None
    while pending:
        pid = pending.popleft()
        if pid in seen:
            continue
        seen.add(pid)
        row = rows.get(pid)
        if row and (tool := agent_kind(row["command"])):
            # Node launchers own the native CLI below them; tool subprocesses do not.
            if Path(row["command"].split()[0]).name in ("node", "bun", "python", "python3"):
                native = next((rows[c] for c in children.get(pid, [])
                               if agent_kind(rows[c]["command"]) == tool), None)
                row = native or row
            home = process_home(row["pid"], tool)
            if home is not None:
                owner = {**row, "tool": tool, "home": home, "checked_at": time.time()}
                write_json(path, owner)
            break
        pending.extend(children.get(pid, []))
    if owner is None:
        write_json(path, {"pid": None, "pane_command": command, "checked_at": time.time()})
    _owner_bindings[pane_pid] = owner
    return owner


def agent_pid_for_pane(pane_pid: int | None, needle: str, exact: bool = False) -> int | None:
    owner = owner_for_pane(pane_pid)
    return owner["pid"] if owner and owner["tool"] == needle else None


def codex_pid_for_pane(pane_pid: int | None) -> int | None:
    return agent_pid_for_pane(pane_pid, "codex")


def claude_pid_for_pane(pane_pid: int | None) -> int | None:
    return agent_pid_for_pane(pane_pid, "claude")


def process_tree_contains(pid: int | None, needle: str) -> bool:
    return agent_pid_for_pane(pid, needle) is not None


def exec_agy_statusline() -> None:
    """Hand an Antigravity CLI pane to its own status line script.

    agy keeps its quota, transcripts and account in a different shape, so it
    lives in ~/.tmux/agy-statusline rather than in this file. sys.executable
    reuses the interpreter already resolved, not a PATH lookup (pyenv shim).
    """
    script = Path(__file__).resolve().with_name("agy-statusline")
    os.execv(sys.executable, [sys.executable, str(script), *sys.argv[1:]])


def rollout_for_pid(codex_pid: int | None, started: str = "") -> str | None:
    """The rollout this pane's codex has open.

    Every session in a worktree records the same `cwd` (they all run commands
    with `git -C` from the main checkout), so selecting a thread by cwd makes
    each pane show whichever session was most recently active — usually another
    pane's. The open file descriptor is the only per-pane fact available.
    """
    if not codex_pid:
        return None
    cache = cache_dir() / f"rollout-{codex_pid}.json"
    try:
        saved = json.loads(cache.read_text())
        if (saved.get("started") == started and time.time() - saved["checked_at"] < 10
                and (saved.get("path") is None or Path(saved["path"]).is_file())):
            return saved["path"]
    except (OSError, ValueError, KeyError, TypeError):
        pass
    try:
        listing = subprocess.run(
            [LSOF, "-p", str(codex_pid), "-Fn"],
            capture_output=True, text=True, timeout=0.4, check=False,
        ).stdout
    except Exception:
        return None
    newest, newest_mtime = None, -1.0
    for line in listing.splitlines():
        if not line.startswith("n") or "rollout-" not in line or not line.endswith(".jsonl"):
            continue
        candidate = Path(line[1:])
        try:
            mtime = candidate.stat().st_mtime
        except OSError:
            continue
        if mtime > newest_mtime:
            newest, newest_mtime = str(candidate), mtime
    write_json(cache, {"started": started, "path": newest, "checked_at": time.time()})
    return newest


def codex_home_for_pane(pane_pid: int | None) -> Path | None:
    owner = owner_for_pane(pane_pid)
    return Path(owner["home"]) if owner and owner["tool"] == "codex" else None


def claude_config_dir_for_pane(pane_pid: int | None) -> Path | None:
    owner = owner_for_pane(pane_pid)
    return Path(owner["home"]) if owner and owner["tool"] == "claude" else None


def claude_account_label(config_dir: Path) -> str:
    """The local part of the signed-in account, for telling two homes apart.

    The OAuth token itself lives in the macOS Keychain, but Claude Code caches
    the signed-in identity in `.claude.json`. The default home keeps that file
    at `$HOME/.claude.json`; a custom CLAUDE_CONFIG_DIR keeps it inside the dir.
    """
    candidates = [config_dir / ".claude.json"]
    if config_dir == Path.home() / ".claude":
        candidates.append(Path.home() / ".claude.json")
    for path in candidates:
        try:
            account = json.loads(path.read_text()).get("oauthAccount") or {}
        except Exception:
            continue
        email = account.get("emailAddress") or ""
        if email:
            return email.split("@", 1)[0]
    return ""


def is_claude_command(command: str | None, pane_pid: int | None = None) -> bool:
    if command and (command == "claude" or command.startswith("claude-") or command.startswith("claude_")):
        return True
    return process_tree_contains(pane_pid, "claude")


def context_bar_color(used: int) -> str:
    # 컨텍스트 게이지: 사용↑ 일수록 위험.
    # ~/.claude/statusline.sh 와 동일한 그라데이션(하늘→파랑→검붉→빨강)을 mirror.
    if used < 40:
        return "colour153"   # 연하늘 (여유 많음)
    if used < 65:
        return "colour111"   # 연파랑
    if used < 82:
        return "colour131"   # 더스티 검붉
    return "colour210"       # 살몬 빨강 (컨텍스트 꽉 참)


def weekly_bar_color(remaining: int) -> str:
    # 주간 잔여량 게이지: 많을수록 안전 (컨텍스트와 반대 방향).
    #   넉넉 → 초록, 줄어들수록 노랑·주황, 얼마 안 남으면 → 빨강.
    if remaining > 50:
        return "colour114"   # 초록 (넉넉)
    if remaining > 30:
        return "colour178"   # 노랑
    if remaining > 12:
        return "colour208"   # 주황
    return "colour167"       # 빨강 (얼마 안 남음)


def percent_bar(remaining: int, color: str, width: int = 14) -> str:
    remaining = max(0, min(100, int(round(remaining))))
    text = f"{remaining}% ".rjust(width)
    filled = max(0, min(width, round(width * remaining / 100)))
    filled_text = text[:filled]
    empty_text = text[filled:]

    return (
        "#[fg=#54546d]["
        f"#[bg={color},fg=#1f1f28,bold]{filled_text}"
        f"#[bg=#2a2a37,fg=#938aa9]{empty_text}"
        "#[default]#[fg=#54546d]]#[default]"
    )


def tail_lines(path: Path, max_bytes: int = CONTEXT_TAIL_BYTES) -> list[bytes]:
    try:
        with path.open("rb") as f:
            f.seek(0, os.SEEK_END)
            end = f.tell()
            start = max(0, end - max_bytes)
            f.seek(start)
            return f.read().splitlines()
    except OSError:
        return []


def context_used_percent(tokens_in_context: int, context_window: int) -> int:
    if context_window <= 0:
        return 0
    used = max(0, min(tokens_in_context, context_window))
    return int(math.floor((used / context_window) * 100.0 + 0.5))


def session_baseline_tokens(rollout: Path) -> int:
    """Tokens already in context at the session's first turn."""
    try:
        with rollout.open("rb") as handle:
            head = handle.read(CONTEXT_TAIL_BYTES)
    except OSError:
        return 0
    for raw_line in head.split(b"\n"):
        try:
            event = json.loads(raw_line)
        except Exception:
            continue
        if event.get("type") != "event_msg":
            continue
        payload = event.get("payload") or {}
        if payload.get("type") != "token_count":
            continue
        usage = (payload.get("info") or {}).get("last_token_usage") or {}
        tokens = usage.get("total_tokens")
        return tokens if isinstance(tokens, int) else 0
    return 0


def latest_context_state(cwd: str | None, rollout: str | None = None) -> dict | None:
    if not rollout:
        return None

    path = Path(rollout)
    cache = cache_dir() / ("context-" + hashlib.sha256(str(path).encode()).hexdigest()[:16] + ".json")
    try:
        stat = path.stat()
        version = [stat.st_ino, stat.st_size, stat.st_mtime_ns]
    except OSError:
        return None
    try:
        saved = json.loads(cache.read_text())
    except (OSError, ValueError):
        saved = {}
    if saved.get("version") == version:
        return saved.get("context")
    previous = saved.get("version")
    baseline = (saved.get("baseline") if isinstance(previous, list) and len(previous) == 3
                and previous[0] == stat.st_ino and previous[1] <= stat.st_size else None)
    for raw_line in reversed(tail_lines(path)):
        try:
            event = json.loads(raw_line)
        except Exception:
            continue
        if event.get("type") != "event_msg":
            continue
        payload = event.get("payload") or {}
        if payload.get("type") != "token_count":
            continue

        info = payload.get("info") or {}
        last = info.get("last_token_usage") or {}
        context_window = info.get("model_context_window")
        total_tokens = last.get("total_tokens")
        if (isinstance(context_window, bool) or not isinstance(context_window, int) or context_window <= 0
                or isinstance(total_tokens, bool) or not isinstance(total_tokens, int) or total_tokens < 0):
            write_json(cache, {"version": version, "baseline": baseline, "context": None})
            return None

        # codex's own footer does not count the session's opening prompt (system
        # instructions plus tool definitions), so a fresh session reads "100%
        # left" while the raw number is already tens of thousands of tokens.
        # Subtract that floor from both sides to match the pane itself; the
        # first token_count in the file is that floor.
        if baseline is None:
            baseline = session_baseline_tokens(path)
        if 0 < baseline < total_tokens < context_window:
            total_tokens -= baseline
            context_window -= baseline

        context = {"used_percent": context_used_percent(total_tokens, context_window),
                   "tokens": total_tokens, "window": context_window}
        write_json(cache, {"version": version, "baseline": baseline, "context": context})
        return context

    write_json(cache, {"version": version, "baseline": baseline, "context": None})
    return None


def latest_claude_state(owner: dict) -> dict | None:
    root = Path(os.environ.get("TMPDIR") or "/tmp") / "claude-tmux-statusline"
    path = root / f"owner-{home_slug(ACTIVE_CLAUDE_CONFIG_DIR)}-{owner['pid']}.json"
    try:
        binding = json.loads(path.read_text())
        session = binding.get("session_id")
        if not session or binding.get("owner_started") != owner["started"]:
            return None
        key = hashlib.sha256((str(ACTIVE_CLAUDE_CONFIG_DIR.resolve()) + "\0" + session).encode()).hexdigest()[:20]
        state = json.loads((root / f"session-{key}.json").read_text())
        if (state.get("owner_pid") == owner["pid"] and state.get("owner_started") == owner["started"]
                and state.get("session_id") == session
                and time.time() - int(state.get("updated_at") or 0) <= CACHE_TTL_SECONDS * 10):
            return state
    except (OSError, ValueError, TypeError):
        pass
    return None


def codex_account_label(codex_home: Path) -> str:
    """The local part of the signed-in account, for telling two homes apart.

    codex stores one account per CODEX_HOME, and the email only exists inside
    the OAuth id_token, so decode that rather than guessing from the directory
    name. API-key logins carry no id_token and get no label.
    """
    try:
        auth = json.loads((codex_home / "auth.json").read_text())
    except Exception:
        return ""
    token = (auth.get("tokens") or {}).get("id_token") or ""
    parts = token.split(".")
    if len(parts) < 2:
        return ""
    payload = parts[1] + "=" * (-len(parts[1]) % 4)
    try:
        email = json.loads(base64.urlsafe_b64decode(payload)).get("email") or ""
    except Exception:
        return ""
    return email.split("@", 1)[0]


def render_line(product: str, state: dict, context_used: int | None, columns: int = 0,
                account: str = "") -> str:
    remaining = int(state["remaining_percent"])
    resets_at = int(state["resets_at"])
    seconds = resets_at - int(time.time())
    timer = countdown_text(seconds)
    fetched_at = int(state.get("fetched_at") or 0)

    product_color = "#e6c384" if product == "CLAUDE" else "#727169"
    product_label = f" {product}  " if product == "CODEX" else f" {product} "
    left = (
        tmux_style(f"fg={product_color},bold", product_label)
        + tmux_style("fg=#dcd7ba", "CONTEXT ")
        + (percent_bar(context_used, context_bar_color(context_used)) if context_used is not None
           else tmux_style("fg=#727169", "—"))
        + (tmux_style("fg=#7aa89f", f" {account}") if account else "")
    )
    if seconds <= 0 or not fetched_at or time.time() - fetched_at > CACHE_TTL_SECONDS * 10:
        right = tmux_style("fg=#e6c384", "WEEKLY — 관측 오래됨")
    else:
        right = (tmux_style("fg=#dcd7ba", "WEEKLY RESET ")
                 + tmux_style("fg=#c8c093", "🗓️ " + timer) + " "
                 + percent_bar(remaining, weekly_bar_color(remaining)))
        if state.get("error"):
            right += tmux_style("fg=#e6c384", " 갱신 실패")
    pad = columns - visible_width(left) - visible_width(right) - 2 if columns else 0
    return left + " " * max(2, pad) + right


def render_claude_line(owner: dict, columns: int = 0, account: str = "") -> str:
    state = latest_claude_state(owner) or {}
    context_used = state.get("context_used_percent")
    remaining, resets = state.get("weekly_remaining_percent"), state.get("weekly_resets_at")
    if remaining is not None and resets is not None:
        return render_line("CLAUDE", {"remaining_percent": remaining, "resets_at": resets,
                                     "fetched_at": state.get("updated_at")}, context_used, columns, account)
    return (tmux_style("fg=#e6c384,bold", " CLAUDE ") + tmux_style("fg=#dcd7ba", "CONTEXT ")
            + (percent_bar(context_used, context_bar_color(context_used)) if context_used is not None
               else tmux_style("fg=#727169", "—"))
            + (tmux_style("fg=#7aa89f", f" {account}") if account else "")
            + tmux_style("fg=#727169", "  WEEKLY — 관측 없음"))


# ── opencode ────────────────────────────────────────────────────────────────
# opencode keeps every session in one sqlite DB; each assistant message carries
# its token usage, model and cost. Zen is pay-as-you-go and has no window, so its
# right-hand side shows spend. The Go subscription does have one: its weekly
# window comes from the usage endpoint below and renders like Codex and Claude.
OPENCODE_DATA_DIR = Path(
    os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
) / "opencode"
OPENCODE_DB = OPENCODE_DATA_DIR / "opencode.db"
OPENCODE_MODELS = Path(
    os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
) / "opencode" / "models.json"


def is_opencode_command(command: str | None, pane_pid: int | None = None) -> bool:
    if command and (command == "opencode" or command.startswith("opencode-")):
        return True
    return process_tree_contains(pane_pid, "opencode")


def opencode_context_limit(provider: str, model: str) -> int:
    """Context window from opencode's own models.dev cache.

    models.json is ~5MB, so the limits are distilled into a small cache keyed by
    its mtime instead of parsing it on every status refresh.
    """
    try:
        mtime = int(OPENCODE_MODELS.stat().st_mtime)
    except OSError:
        return 0
    small = cache_dir() / "opencode-context-limits.json"
    try:
        cached = json.loads(small.read_text())
        if cached.get("mtime") == mtime:
            return int(cached["limits"].get(f"{provider}/{model}") or 0)
    except Exception:
        pass
    try:
        data = json.loads(OPENCODE_MODELS.read_text())
    except Exception:
        return 0
    limits = {}
    for provider_id, entry in data.items():
        for model_id, spec in ((entry or {}).get("models") or {}).items():
            context = ((spec or {}).get("limit") or {}).get("context")
            if context:
                limits[f"{provider_id}/{model_id}"] = int(context)
    try:
        write_json(small, {"mtime": mtime, "limits": limits})
    except OSError:
        pass
    return int(limits.get(f"{provider}/{model}") or 0)


def opencode_session_for_pane(pane_pid: int | None) -> str | None:
    """The session this pane's opencode was started on (`-s`/`--session`).

    Panes that share a directory would otherwise all show whichever session was
    touched last. A pane started without the flag falls back to the directory.
    """
    pid = agent_pid_for_pane(pane_pid, "opencode")
    if not pid:
        return None
    try:
        argv = subprocess.run(
            [PS, "-o", "command=", "-p", str(pid)],
            capture_output=True, text=True, timeout=0.2, check=False,
        ).stdout.split()
    except Exception:
        return None
    for index, token in enumerate(argv):
        if token in ("-s", "--session") and index + 1 < len(argv):
            return argv[index + 1]
        if token.startswith("--session="):
            return token.split("=", 1)[1]
    return None


def opencode_title_for_pane(pane_pid: int | None) -> str:
    """The session title opencode put in the pane title ("OC | <title>").

    A pane moves to a new session without restarting, so argv goes stale; the
    title follows the session. tmux truncates it with an ellipsis.
    """
    if not pane_pid:
        return ""
    try:
        listing = subprocess.run(
            [TMUX, "list-panes", "-a", "-F", "#{pane_pid}\t#{pane_title}"],
            capture_output=True, text=True, timeout=0.2, check=False,
        ).stdout
    except Exception:
        return ""
    for line in listing.splitlines():
        pid, _, title = line.partition("\t")
        if pid == str(pane_pid) and title.startswith("OC | "):
            return title[5:].rstrip("…").rstrip()
    return ""


def opencode_state(cwd: str | None, session_id: str | None = None, title: str = "") -> dict:
    """Latest session in the pane's directory + spend today / this week.

    Read-only, with a short busy timeout, so a running opencode is never blocked.
    Messages still streaming (or errored) report zero tokens and are skipped.
    """
    if not OPENCODE_DB.exists():
        return {}
    try:
        conn = sqlite3.connect(f"file:{OPENCODE_DB}?mode=ro", uri=True, timeout=0.3)
    except sqlite3.Error:
        return {}
    state: dict = {}
    try:
        session = None
        if title:
            session = conn.execute(
                "select id from session where parent_id is null and substr(title, 1, ?) = ? "
                "order by time_updated desc limit 1",
                (len(title), title),
            ).fetchone()
        session = session or ((session_id,) if session_id else None) or conn.execute(
            "select id from session where directory = ? order by time_updated desc limit 1",
            (cwd or "",),
        ).fetchone()
        if session:
            row = conn.execute(
                "select data from message where session_id = ? "
                "and json_extract(data, '$.role') = 'assistant' "
                "and coalesce(json_extract(data, '$.tokens.total'), "
                "json_extract(data, '$.tokens.input') + json_extract(data, '$.tokens.output'), 0) > 0 "
                "order by time_created desc limit 1",
                (session[0],),
            ).fetchone()
            if row:
                message = json.loads(row[0])
                tokens = message.get("tokens") or {}
                cache = tokens.get("cache") or {}
                total = int(tokens.get("total") or 0) or (
                    int(tokens.get("input") or 0) + int(tokens.get("output") or 0)
                    + int(tokens.get("reasoning") or 0)
                    + int(cache.get("read") or 0) + int(cache.get("write") or 0)
                )
                provider = str(message.get("providerID") or "")
                model = str(message.get("modelID") or "")
                limit = opencode_context_limit(provider, model)
                state["model"] = model
                state["provider"] = provider
                if limit:
                    state["context_used_percent"] = context_used_percent(total, limit)

        local = time.localtime()
        day_start = time.mktime((local.tm_year, local.tm_mon, local.tm_mday, 0, 0, 0, 0, 0, -1))
        week_start = day_start - local.tm_wday * 86400  # 월요일 00:00
        spent = conn.execute(
            "select "
            "coalesce(sum(case when time_created >= ? then json_extract(data, '$.cost') end), 0), "
            "coalesce(sum(json_extract(data, '$.cost')), 0) "
            "from message where time_created >= ? and json_extract(data, '$.role') = 'assistant'",
            (int(day_start * 1000), int(week_start * 1000)),
        ).fetchone()
        if spent:
            state["spend_today"] = float(spent[0] or 0)
            state["spend_week"] = float(spent[1] or 0)
    except (sqlite3.Error, ValueError):
        pass
    finally:
        conn.close()
    return state


def money(amount: float) -> str:
    # 무료 모델 위주라 1센트 미만이 흔하다 — $0.00 으로 찍으면 안 쓴 것처럼 보인다.
    if 0 < amount < 0.01:
        return "<$0.01"
    return f"${amount:.2f}"


# OpenCode Go keeps its limits server-side (5h / weekly / monthly, in dollars).
# The console does not expose them to the CLI, but the Go API answers
#   GET /zen/go/v1/usage  ->  {"usage": {"weekly": {"percent", "resetsAt"}, ...}}
# with the same key opencode stores for the provider. `percent` is *used* and is
# floored to an integer, so light use reads 0% used for a while. The weekly
# window is fixed: it resets Monday 00:00 UTC. The endpoint is undocumented —
# on any failure the line falls back to spend only, never to a guessed bar.
OPENCODE_AUTH = OPENCODE_DATA_DIR / "auth.json"
OPENCODE_GO_USAGE_URL = "https://opencode.ai/zen/go/v1/usage"
OPENCODE_GO_PROVIDER = "opencode-go"


def opencode_go_cache_file() -> Path:
    return cache_dir() / "opencode-go-usage.json"


def opencode_go_lock_file() -> Path:
    return cache_dir() / "opencode-go-refresh.lock"


def opencode_go_key() -> str:
    try:
        auth = json.loads(OPENCODE_AUTH.read_text())
    except Exception:
        return ""
    for provider in (OPENCODE_GO_PROVIDER, "opencode"):
        key = (auth.get(provider) or {}).get("key")
        if key:
            return str(key)
    return ""


def iso_to_epoch(value: str) -> int:
    from datetime import datetime
    return int(datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp())


def refresh_opencode_go() -> int:
    import urllib.request

    lock = opencode_go_lock_file()
    try:
        state = json.loads(opencode_go_cache_file().read_text())
    except Exception:
        state = {}
    try:
        key = opencode_go_key()
        if not key:
            raise RuntimeError("no opencode-go key")
        request = urllib.request.Request(
            OPENCODE_GO_USAGE_URL,
            headers={"Authorization": f"Bearer {key}", "User-Agent": "tmux-statusline"},
        )
        with urllib.request.urlopen(request, timeout=FETCH_TIMEOUT_SECONDS) as response:
            weekly = json.loads(response.read().decode())["usage"]["weekly"]
        used = weekly.get("percent")
        if isinstance(used, bool) or not isinstance(used, (int, float)) or not math.isfinite(used) or not 0 <= used <= 100:
            raise ValueError("weekly usage unavailable")
        state = {
            "remaining_percent": round(100.0 - used),
            "resets_at": iso_to_epoch(weekly["resetsAt"]),
            "fetched_at": int(time.time()),
            "error": None,
        }
    except Exception as exc:
        state.update({"error": str(exc)[:200], "error_at": int(time.time())})
    try:
        target = opencode_go_cache_file()
        write_json(target, state)
    finally:
        try:
            lock.unlink()
        except FileNotFoundError:
            pass
    return 0


def opencode_go_weekly() -> dict:
    """Cached weekly window; kicks a background refresh when the cache is old."""
    try:
        state = json.loads(opencode_go_cache_file().read_text())
    except Exception:
        state = {}
    last_try = max(int(state.get("fetched_at") or 0), int(state.get("error_at") or 0))
    if time.time() - last_try > CACHE_TTL_SECONDS:
        lock = opencode_go_lock_file()
        try:
            fd = os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.close(fd)
            subprocess.Popen(
                [sys.executable, __file__, "--refresh-opencode-go"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except FileExistsError:
            try:
                if time.time() - lock.stat().st_mtime > FETCH_TIMEOUT_SECONDS * 2:
                    lock.unlink()
            except OSError:
                pass
        except Exception:
            pass
    if ("remaining_percent" in state and state.get("resets_at", 0) > time.time()
            and time.time() - state.get("fetched_at", 0) <= CACHE_TTL_SECONDS * 10):
        return state
    return {}


def render_opencode_line(cwd: str | None, columns: int = 0, pane_pid: int | None = None) -> str:
    state = opencode_state(
        cwd, opencode_session_for_pane(pane_pid), opencode_title_for_pane(pane_pid)
    )
    context_used = state.get("context_used_percent")
    left = (
        tmux_style("fg=#957fb8,bold", " OPENCODE ")
        + (tmux_style("fg=#727169", f"{state['model'][:24]} ") if state.get("model") else "")
        + tmux_style("fg=#dcd7ba", "CONTEXT ")
        + (percent_bar(context_used, context_bar_color(context_used)) if context_used is not None
           else tmux_style("fg=#727169", "—"))
    )
    weekly = opencode_go_weekly() if state.get("provider") == OPENCODE_GO_PROVIDER else {}
    is_go = state.get("provider") == OPENCODE_GO_PROVIDER
    if "spend_week" not in state and not weekly and not is_go:
        return left
    right = tmux_style("fg=#e6c384", "WEEKLY — 조회 불가   ") if is_go and not weekly else ""
    if "spend_week" in state:
        right += (
            tmux_style("fg=#dcd7ba", "SPEND ")
            + tmux_style("fg=#727169", "TODAY ")
            + tmux_style("fg=#c8c093", money(state['spend_today']))
            + tmux_style("fg=#727169", "  WEEK ")
            + tmux_style("fg=#c8c093", money(state['spend_week']))
        )
    if weekly:
        # Same right-hand block as Codex and Claude: countdown + weekly remaining.
        seconds = int(weekly["resets_at"]) - int(time.time())
        stale = tmux_style("fg=#e6c384", " 갱신 실패") if weekly.get("error") else ""
        remaining = int(weekly["remaining_percent"])
        right += (
            ("   " if right else "")
            + tmux_style("fg=#dcd7ba", "WEEKLY RESET ")
            + tmux_style("fg=#c8c093", "🗓️ " + countdown_text(seconds))
            + " "
            + percent_bar(remaining, weekly_bar_color(remaining))
            + stale
        )
    pad = columns - visible_width(left) - visible_width(right) - 2 if columns else 0
    return left + " " * max(2, pad) + right

def refresh(lock_held: bool = False) -> int:
    if not lock_held and not acquire_lock():
        return 0
    try:
        state = read_cache()
        try:
            state.update(extract_state(app_server_request()))
        except Exception as exc:
            state.update({"error": str(exc), "error_at": int(time.time())})
            if "remaining_percent" not in state or "resets_at" not in state:
                state["line"] = tmux_style("fg=#ff5d62", " CODEX weekly unavailable ")
        write_cache(state)
        return 0
    finally:
        release_lock()


def start_background_refresh() -> None:
    if not acquire_lock():
        return
    try:
        subprocess.Popen(
            [sys.executable, __file__, "--refresh", "--lock-held",
             "--codex-home", str(ACTIVE_CODEX_HOME)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        release_lock()


def print_status() -> int:
    global ACTIVE_CODEX_HOME, ACTIVE_CLAUDE_CONFIG_DIR, _processes, _owner_bindings
    _processes, _owner_bindings = None, {}
    args = sys.argv[1:]
    if len(args) < 4:
        print("")
        return 0
    command, cwd = args[:2]
    try:
        columns, pane_pid = int(args[2]), int(args[3])
    except ValueError:
        print("")
        return 0
    owner = owner_for_pane(pane_pid, command)
    if not owner:
        print(tmux_style("fg=#727169", " AGENT — 조회 불가") if agent_kind(command) else "")
        return 0
    tool = owner["tool"]
    if tool == "agy":
        os.environ["STATUSLINE_AGENT_PID"] = str(owner["pid"])
        os.environ["STATUSLINE_AGENT_STARTED"] = owner["started"]
        exec_agy_statusline()
    if tool == "opencode":
        print(render_opencode_line(cwd, columns, pane_pid))
        return 0
    if tool == "claude":
        ACTIVE_CLAUDE_CONFIG_DIR = Path(owner["home"])
        print(render_claude_line(owner, columns, claude_account_label(ACTIVE_CLAUDE_CONFIG_DIR)))
        return 0
    ACTIVE_CODEX_HOME = Path(owner["home"])
    state = read_cache()
    now = int(time.time())
    logical_cwd = args[4] if len(args) >= 5 and args[4] else cwd
    context = latest_context_state(logical_cwd, rollout_for_pid(owner["pid"], owner["started"]))
    context_used = context["used_percent"] if context else None
    last_try = max(int(state.get("fetched_at") or 0), int(state.get("error_at") or 0))
    if now - last_try > CACHE_TTL_SECONDS:
        start_background_refresh()
    if "remaining_percent" in state and "resets_at" in state:
        print(render_line("CODEX", state, context_used, columns, codex_account_label(ACTIVE_CODEX_HOME)))
    elif state.get("line"):
        print(state["line"])
    else:
        print(tmux_style("fg=#727169", " CODEX weekly loading... "))
    return 0


def main() -> int:
    global ACTIVE_CODEX_HOME
    if "--codex-home" in sys.argv:
        ACTIVE_CODEX_HOME = Path(sys.argv[sys.argv.index("--codex-home") + 1])
    if "--refresh-opencode-go" in sys.argv:
        return refresh_opencode_go()
    if "--refresh" in sys.argv:
        return refresh(lock_held="--lock-held" in sys.argv)
    return print_status()


if __name__ == "__main__":
    raise SystemExit(main())
