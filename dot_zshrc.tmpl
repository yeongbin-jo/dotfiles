# ============================================================
#  ~/.zshrc  —  chezmoi 로 3대 Mac 공통 관리 (source: dot_zshrc.tmpl)
#  민감/머신별 SSH alias 등은 ~/.zshrc.local (age 암호화, 맨 끝에서 source)
# ============================================================

# ── oh-my-zsh ──
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
plugins=(git)

# Docker CLI 자동완성 fpath: oh-my-zsh 의 compinit 전에 추가 (중복 compinit 방지)
fpath=("$HOME/.docker/completions" $fpath)
# sentry-cli 자동완성 (설치된 머신에서만)
[ -d "$HOME/.local/share/zsh/site-functions" ] && fpath=("$HOME/.local/share/zsh/site-functions" $fpath)
source "$ZSH/oh-my-zsh.sh"

# ── 기본 환경 ──
export LANG=ko_KR.UTF-8
export EDITOR='vim'
export SHELL=/bin/zsh
export KEYTIMEOUT=1
export POETRY_VIRTUALENVS_IN_PROJECT=true

# 프롬프트: agnoster 앞에 날짜/시간 세그먼트 (반드시 oh-my-zsh source 뒤)
SEGMENT_SEPARATOR=$'\ue0b0'
PROMPT='%{$fg[black]%}%{$bg[green]%} %D{%y/%m/%d} %D{%H:%M:%S} %{$fg[green]%}%{$bg[black]%}$SEGMENT_SEPARATOR'$PROMPT
DISABLE_UPDATE_PROMPT=true

# ── vi 모드 키바인딩 ──
if [[ -o interactive ]]; then
  set -o vi
  bindkey -v
  bindkey '\e[3~' delete-char
  bindkey '^R' history-incremental-search-backward   # fzf 미설치 시 fallback
fi

# ── brew ──
eval "$(/opt/homebrew/bin/brew shellenv)"

# ── PATH ──
export PATH="$HOME/.orbstack/bin:$PATH"                         # OrbStack docker/kubectl shims
path=("$HOME/.local/bin" "${path[@]:#$HOME/.local/bin}")        # Codex standalone installer
export PATH
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"                       # psql
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$PATH:$ANDROID_HOME/platform-tools:$ANDROID_HOME/build-tools/36.0.0"
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in *":$PNPM_HOME:"*) ;; *) export PATH="$PNPM_HOME:$PATH" ;; esac

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# cargo
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# ── 런타임 매니저 (lazy = 셸 시작 빠르게) ──
{{- if stat (joinPath .chezmoi.homeDir ".nvm") }}
# nvm: 기본 node 의 bin 을 PATH 에 직접 추가 (실 바이너리 → /bin/sh·tauri 등 subprocess 가 inherit).
# (옛 lazy 함수 방식은 node 가 zsh 함수라 subprocess 에서 'node: not found' 발생 → 폐기.)
# nvm.sh 전체 소싱(느림)은 `nvm` 명령 첫 호출 때만 lazy 로.
export NVM_DIR="$HOME/.nvm"
if [ -d "$NVM_DIR/versions/node" ]; then
  _nvm_pick=""
  if [ -f "$NVM_DIR/alias/default" ]; then
    _nvm_d="$(cat "$NVM_DIR/alias/default" 2>/dev/null)"
    for _nvm_c in "$_nvm_d" "v$_nvm_d"; do
      [ -d "$NVM_DIR/versions/node/$_nvm_c/bin" ] && _nvm_pick="$_nvm_c" && break
    done
  fi
  [ -z "$_nvm_pick" ] && _nvm_pick="$(ls -1 "$NVM_DIR/versions/node" 2>/dev/null | sort -V | tail -1)"
  [ -n "$_nvm_pick" ] && PATH="$NVM_DIR/versions/node/$_nvm_pick/bin:$PATH"
  unset _nvm_pick _nvm_d _nvm_c
fi
# `nvm` 명령만 lazy (버전 전환 시에만 nvm.sh 소싱)
nvm() { unset -f nvm; [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"; [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"; nvm "$@"; }
{{- end }}
{{- if stat (joinPath .chezmoi.homeDir ".pyenv") }}

# pyenv: shims 즉시 PATH(= python/pip/poetry 동작), 무거운 init 처리
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH"
{{- if eq .pyenv_init "eager-virtualenv" }}
eval "$(pyenv init -)"
eval "$(pyenv virtualenv-init -)"
{{- else }}
pyenv() { unset -f pyenv; eval "$(command pyenv init - zsh)"; pyenv "$@"; }
{{- end }}
{{- end }}

# direnv
eval "$(direnv hook zsh)"

# google-cloud-sdk
[ -f "$HOME/Downloads/google-cloud-sdk/path.zsh.inc" ]       && . "$HOME/Downloads/google-cloud-sdk/path.zsh.inc"
[ -f "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc" ] && . "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc"

# ── 별칭 ──
alias vi="vim"
alias dps='docker ps --format "table {{ `{{.ID}}\t{{.Image}}\t{{.Status}}\t{{.Names}}` }}"'
alias dip='docker inspect -f "{{ `{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}` }}"'
alias scrcpy='scrcpy --stay-awake'
alias lock='lock-screen'                                              # 즉시 비번 잠금(작업은 계속 실행)
alias claude-yolo='claude --dangerously-skip-permissions'
alias codex-yolo='codex --dangerously-bypass-approvals-and-sandbox'
# ── opencode: 승인 프롬프트 없이, 단 되돌리기 어려운 것만 막고 ──
#    opencode 에는 claude 의 --dangerously-skip-permissions 같은 플래그가 없다.
#    권한은 설정으로만 정해지고, OPENCODE_CONFIG_CONTENT 가 프로젝트 설정보다
#    우선하므로 이 호출에서만 규칙을 덮어쓴다.
#
#    🚨 deny 패턴의 선행 `*` 를 지우지 말 것. 패턴은 명령 문자열 앞에서 고정
#    매칭된다(실측: `DENYME*` 는 `echo DENYME hello` 를 못 잡는다). 선행 `*` 가
#    없으면 `cd frontend && pnpm build` 같은 체이닝에 전부 뚫린다.
#    구체 패턴이 와일드카드를 이긴다는 것도 실측 확인(2026-09-18, opencode 1.18.31).
opencode-yolo() {
  local rules='{"permission":{"*":"allow","bash":{"*":"allow",
    "*pnpm build*":"deny",
    "*--no-verify*":"deny",
    "*git push*--force*":"deny",
    "*git push*-f *":"deny",
    "*git push*-f":"deny",
    "*git reset*--hard*":"deny",
    "*git commit*--amend*":"deny"}}}'
  OPENCODE_CONFIG_CONTENT="$rules" opencode "$@"
}
# ── 두 번째 codex 계정 ──
#    codex 에는 계정 전환 기능이 없다. 인증은 CODEX_HOME 하나에 auth.json 한
#    벌뿐이라, 홈을 갈라야 계정이 갈린다(커뮤니티의 codex-profiles/aisw 등도
#    전부 같은 방식). 바이너리와 스킬은 심링크로 공유하고 인증·세션·plugins·
#    connectors 만 분리한다 — 공유하면 한쪽 커넥터 설정이 다른 쪽에 샌다.
#    설정은 심링크가 아니라 사본이다: codex 가 원자적 교체로 쓰면 심링크가
#    실제 파일로 바뀌어 조용히 공유가 끊긴다.
alias codex2='CODEX_HOME=$HOME/.codex-eng codex'
alias codex-yolo2='CODEX_HOME=$HOME/.codex-eng codex --dangerously-bypass-approvals-and-sandbox'
# ── 두 번째 claude 계정 ──
#    같은 구조다. claude 도 계정 전환 기능이 없고 로그인 상태가
#    CLAUDE_CONFIG_DIR 에 묶인다(빈 dir 로 `claude auth status` 하면
#    loggedIn=false — 토큰이 Keychain 에 있어도 config dir 이 인증을 가른다).
#    이 값은 셸에서 줘야 하고 실행 중에는 못 바꾼다.
#    홈 이름에 계정을 박지 않는다: 어느 계정이 기본이고 어느 계정이 두 번째인지는
#    머신마다 다르고, 두 번째 홈에 누가 로그인하느냐가 곧 그 머신의 두 번째 계정이다.
#    예전 이름 ~/.claude-vb 로 이미 로그인해 쓰는 머신은 그 홈을 그대로 쓴다 —
#    옮기면 로그인과 진행 중인 세션이 끊긴다.
#    구성은 ~/.local/share/chezmoi-private 의 setup-claude-second-account 가 만든다.
# 번호 홈(~/.claude2, ~/.claude3)을 쓰되, 예전 이름 홈(legacy)만 있으면 그걸 쓴다.
_claude_home() {
  if [ ! -e "$HOME/.claude$1" ] && [ -d "$HOME/$2" ]; then
    print -r -- "$HOME/$2"
  else
    print -r -- "$HOME/.claude$1"
  fi
}
alias claude2='CLAUDE_CONFIG_DIR=$(_claude_home 2 .claude-vb) claude'
alias claude-yolo2='CLAUDE_CONFIG_DIR=$(_claude_home 2 .claude-vb) claude --dangerously-skip-permissions'
# ── 세 번째 claude 계정 (계정 3개인 머신만 홈이 만들어진다) ──
#    같은 규칙. 예전 이름 ~/.claude-eng 로 이미 쓰는 머신은 그 홈을 그대로 쓴다.
alias claude3='CLAUDE_CONFIG_DIR=$(_claude_home 3 .claude-eng) claude'
alias claude-yolo3='CLAUDE_CONFIG_DIR=$(_claude_home 3 .claude-eng) claude --dangerously-skip-permissions'
alias clean_cache='rm -rf ~/Library/Developer/Xcode/DerivedData/* ~/Library/Developer/Xcode/iOS\ DeviceSupport/* ~/Library/Caches/*'
{{- if eq .machine "m2-air" }}
alias run=./run
alias p2r="poetry export --without-hashes --without-urls | awk '{ print $1 }' FS=';' > requirements.txt"
{{- end }}

# ── nydus: Tailscale 머신의 tmux 세션 attach-or-create (ssh+tmux 터널) ──
#   nydus                   →  이 머신의 nydus 세션
#   nydus <host>            →  <host> 의 nydus 세션
#   nydus <host> <session>  →  <host> 의 <session> 세션 (예: nydus m5-pro stress)
#   nydus . <session>       →  이 머신의 <session> 세션 (<host> 가 이 머신 이름이어도 같다)
#   세션 안에서 claude, 빠져나오기 Ctrl-b d. 이미 tmux 안이면 중첩하지 않고 그 세션으로 전환한다.
#   비공개 호스트(특수 동작)는 ~/.zshrc.local 의 _nydus_special 가 먼저 처리(있으면, 세션 미지정일 때만)
nydus() {
  local host="$1" session="${2:-nydus}"
  case "$session" in
    *[!A-Za-z0-9_-]*) echo "nydus: 세션 이름은 영문·숫자·_·- 만 쓸 수 있다: $session" >&2; return 2 ;;
  esac
  if [ -z "$host" ] || [ "$host" = . ] || [ "$host" = "${HOST%%.*}" ]; then
    if [ -n "${TMUX:-}" ]; then
      tmux has-session -t "=$session" 2>/dev/null || tmux new-session -d -s "$session"
      tmux switch-client -t "=$session"
    else
      tmux new -A -s "$session"
    fi
    return
  fi
  if [ -z "$2" ] && typeset -f _nydus_special >/dev/null 2>&1 && _nydus_special "$host"; then return; fi
  case "$host" in
    win-*) ssh -t "$host" "wsl tmux new -A -s $session" ;;  # Windows: tmux는 WSL 안에서
    *)     ssh -t "$host" "PATH=\"/opt/homebrew/bin:/usr/local/bin:\$PATH\"; exec tmux new -A -s $session" ;;
  esac
}

# Reap a stale Codex worktree claim on this pane. The tab name itself is governed
# entirely by tmux.conf's automatic-rename-format (which prefers @codex_workdir and
# falls back to pane_current_path) — automatic-rename is never disabled, so a tab can
# no longer freeze. This hook only drops the pane's @codex_workdir once the interactive
# shell has moved off the claimed worktree (human took the pane back) or it was removed,
# so the format cleanly falls back to the real cwd. Runs at the prompt only, so it never
# fights a Codex run in progress.
_clear_stale_codex_tmux_workdir() {
  [ -n "${TMUX:-}" ] || return 0
  [ -n "${TMUX_PANE:-}" ] || return 0
  command -v tmux >/dev/null 2>&1 || return 0

  local codex_workdir current_root codex_root
  codex_workdir="$(tmux display-message -p -t "$TMUX_PANE" '#{@codex_workdir}' 2>/dev/null || true)"
  [ -n "$codex_workdir" ] || return 0

  current_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")"
  codex_root="$(git -C "$codex_workdir" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$codex_workdir")"
  # Still inside the claimed worktree and it exists → keep the claim.
  if [ "$current_root" = "$codex_root" ] && [ -d "$codex_workdir" ]; then
    return 0
  fi

  tmux set-option -p -q -u -t "$TMUX_PANE" @codex_workdir 2>/dev/null || true
  tmux set-option -p -q -u -t "$TMUX_PANE" @codex_worktree_name 2>/dev/null || true
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd _clear_stale_codex_tmux_workdir
add-zsh-hook chpwd _clear_stale_codex_tmux_workdir

# ── tmux 창 이름 stale 방지: 프롬프트로 돌아왔으면 그 작업은 끝났다 ──
#    창 이름은 tmux.conf 의 automatic-rename-format 이 계산하고, 유일한 예외가
#    pane 옵션 @agent_title 이다(`tab-title` 이 쓴다). 프로세스가 죽어도 그 옵션은
#    남으므로 프롬프트마다 해제해 tmux 순정 규칙(#{pane_current_command})으로 되돌린다.
_reset_tmux_pane_title() {
  [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || return 0
  tmux set-option -p -t "$TMUX_PANE" -u @agent_title 2>/dev/null
  tmux set-window-option -t "$TMUX_PANE" automatic-rename on 2>/dev/null
}
add-zsh-hook precmd _reset_tmux_pane_title

# ── dotfiles 최신화: 공개 소스 + 비공개 오버레이를 한 번에 (drift 방지) ──
#   chezmoi 소스가 둘(공개 dotfiles + 비공개 dotfiles-private)이라 apply 를 각각 돌려야 함.
#   구현은 ~/.local/bin/dotfiles-sync (non-interactive/에이전트에서도 쓰도록 스크립트). dotup 은 그 래퍼.
#   상태 점검은 `dotfiles-doctor` (private 오버레이 미clone/미apply/uncommitted 를 경고).
dotup() { "$HOME/.local/bin/dotfiles-sync" "$@"; }

# ── 머신별/민감 설정 (장비 alias 등, age 암호화) ──
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# ── 모던 CLI 도구 (설치돼 있을 때만 로드 → fresh 머신서도 에러 없음) ──
if [[ -o interactive && -t 0 && -t 1 ]] && command -v fzf >/dev/null; then
  source <(fzf --zsh)                                     # Ctrl-R 히스토리 / Ctrl-T 파일 / Alt-C 디렉터리
fi
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"   # z <dir> 스마트 점프
if command -v eza >/dev/null; then
  alias ls='eza --group-directories-first'
  alias ll='eza -lah --git --group-directories-first'
  alias la='eza -lah --group-directories-first'
  alias lt='eza --tree --level=2'
fi
command -v bat >/dev/null && alias cat='bat --paging=never'
[ -r /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# zsh-syntax-highlighting 은 반드시 맨 마지막 source
[ -r /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# 커서는 Ghostty 설정으로 처리 (shell-integration-features=no-cursor + cursor-style=block)
