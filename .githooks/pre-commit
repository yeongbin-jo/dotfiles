#!/bin/sh
# public dotfiles leak guard — 스테이지된 평문 파일에 개인/회사 식별자가 있으면 커밋을 막는다.
#   generic:  IPv4, *.ts.net, tailnet ID, 키/토큰 시그니처
#   denylist: ~/.config/dotfiles/public-denylist (private overlay 가 배포; 한 줄 = grep -E 패턴, '#' 주석)
#   우회(정말 필요할 때만):  DOTFILES_ALLOW_LEAK=1 git commit ...
[ "${DOTFILES_ALLOW_LEAK:-}" = "1" ] && exit 0
generic='([0-9]{1,3}\.){3}[0-9]{1,3}|\.ts\.net|\btail[0-9a-f]{6}\b|AGE-SECRET-KEY|BEGIN [A-Z ]*PRIVATE KEY|ghp_[A-Za-z0-9]{20,}|github_pat_|xox[bpa]-[0-9]|AKIA[0-9A-Z]{12}|sk-[A-Za-z0-9]{20,}'
allow='127\.0\.0\.1|0\.0\.0\.0|255\.255\.255\.255|([0-9]+\.){3}[0-9]+\.[0-9]'   # loopback/broadcast/버전문자열
deny="$HOME/.config/dotfiles/public-denylist"
pat="$generic"
if [ -r "$deny" ]; then
  extra=$(grep -v '^[[:space:]]*#' "$deny" | grep -v '^[[:space:]]*$' | paste -sd '|' -)
  [ -n "$extra" ] && pat="$pat|$extra"
else
  echo "pre-commit: warning: $deny 없음 — generic 패턴만 검사 (private overlay 를 apply 하면 생긴다)" >&2
fi
status=0
for f in $(git diff --cached --name-only --diff-filter=AM); do
  case "$f" in .githooks/*|*.age|*.png|*.jpg|*.gif|*.pdf) continue;; esac   # 훅 자신은 패턴을 담고 있으므로 제외
  hits=$(git show ":$f" | grep -n -I -E "$pat" | grep -v -E "$allow" || true)
  if [ -n "$hits" ]; then
    [ $status = 0 ] && echo "pre-commit: 공개 레포에 넣으면 안 되는 식별자가 있습니다 (private overlay 로 옮기세요):" >&2
    echo "$hits" | sed "s#^#  $f:#" >&2
    status=1
  fi
done
exit $status
