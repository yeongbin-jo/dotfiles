# ============================================================
#  ~/.tmux.conf  —  chezmoi 관리 (Mac + Linux 서버 공통, 템플릿)
#  · OS 분기: {{ .chezmoi.os }} / role: {{ .role }}
# ============================================================

# ── 기본 ──
set -g mouse on
set -g default-terminal "tmux-256color"
set -as terminal-features "*:cstyle"
set -as terminal-features "xterm-ghostty:RGB"      # truecolor (24bit)

# ── sane defaults (tmux-sensible 핵심 인라인) ──
set -sg escape-time 0           # vi ESC 지연 제거
set -g  focus-events on
setw -g aggressive-resize on
set -g  display-time 2000

# ── 인덱스 / 히스토리 ──
set -g  base-index 1            # 창 번호 1부터
setw -g pane-base-index 1       # 패널 번호 1부터
set -g  renumber-windows on     # 창 닫으면 번호 재정렬
set -g  history-limit 50000     # 스크롤백 5만 줄

# ── 직관적 분할 + 현재 경로 유지 ──
unbind %
unbind '"'
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind c new-window      -c "#{pane_current_path}"

# ── Option(Alt)+숫자 = 창 바로 이동 (prefix 없이) ──
bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5
bind -n M-6 select-window -t 6
bind -n M-7 select-window -t 7
bind -n M-8 select-window -t 8
bind -n M-9 select-window -t 9

# ── 설정 리로드 (prefix r) ──
bind r source-file ~/.tmux.conf \; display "tmux.conf reloaded ✓"

# ── 창 이름 = 에이전트가 스스로 쓴 작업 요약 (없으면 tmux 순정 규칙) ──
#    claude / codex 는 자기가 지금 하는 일을 OSC 2 로 터미널 타이틀에 계속 써 넣는다.
#    tmux 는 그 값을 allow-rename 과 무관하게 #{pane_title} 에 항상 받아둔다
#    (allow-rename 은 screen 계열 `ESC k` 전용 — 켜면 oh-my-zsh 가 창 이름을 뺏는다).
#    → 창 이름 = pane_title. 목적이 바뀌면 에이전트가 제 손으로 갱신하므로 tmux 쪽에
#      브랜치/워크트리 계산도 재평가 넛지도 필요 없다(#() 서브셸 0개, OSC 수신 자체가
#      PANE_CHANGED 를 세워 즉시 재계산된다).
#    · 폴백: pane_title 이 ① 호스트명(패널 기본값) ② 빈 문자열 ③ UUID 를 포함할 때만
#      tmux 순정 규칙. ③ 은 codex 가 이름 없는 스레드에서 thread-title 대신 스레드
#      UUID 를 쏘기 때문(정규식에 {n} 반복은 못 쓴다 — 중괄호가 포맷을 닫아버림).
#      ①②③ 아니면 tmux 순정 규칙
#      (#{pane_current_command} = zsh / vim / …).
#    · zsh 는 프롬프트로 돌아올 때 .zshrc 의 precmd 훅이 pane_title 을 호스트명으로
#      되돌린다 → 에이전트가 죽어도 마지막 작업 요약이 얼어붙지 않는다.
#    · 24자에서 자른다(상태줄 잠식 방지).
set -g  allow-rename off
setw -g automatic-rename on
setw -g automatic-rename-format '#{?#{||:#{||:#{==:#{pane_title},#{host_short}},#{==:#{pane_title},}},#{m/r:[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-,#{pane_title}}},#{pane_current_command},#{=24:pane_title}}'

# ============================================================
#  상태바 — 위쪽 + Kanagawa (미니멀: 배경블록 없음)
#  · 상태바 자체는 플러그인 0 (TPM 불필요), #() 인라인 셸 위젯
#  · 현재 창 = 밝은 블루+볼드 / 비활성 창 = 디밍 그레이 (배경 X)
#  · tmux 함정 두 가지를 회피하도록 작성됨:
#    (1) tmux는 status 전체에 strftime을 적용 → #() 명령 텍스트엔 '%' 와 ')' 금지
#        (퍼센트 기호는 #() 바깥에 '%%' 리터럴로 둔다 → strftime이 '%'로 변환)
#    (2) tmux는 "큰따옴표" config에서 $VAR/${VAR}를 자기 환경변수로 먹어버림
#        → 셸 변수 쓰는 #() 줄은 outer='작은따옴표', inner="큰따옴표" 로 작성
#  · 색상은 #() 가 #[fg=..] 를 직접 출력해서 부하에 따라 동적으로 바뀐다.
# ============================================================
set -g status-position top
set -g status 2
set -g status-interval 1
set -g status-justify left
set -g status-style "bg=#1f1f28,fg=#dcd7ba"

# ── 왼쪽: 세션명 (crystalBlue 볼드) ──
set -g status-left-length 40
set -g status-left '#[fg=#7e9cd8,bold] #S #[default]'

# ── 창 목록 (현재=블루 볼드, 비활성=디밍 그레이 / 줌=Z) ──
setw -g window-status-separator ""
setw -g window-status-format         '#[fg=#727169] #I #W '
setw -g window-status-current-format '#[fg=#7e9cd8,bold] #I #W#{?window_zoomed_flag, Z,} #[default]'

# ── 오른쪽: SYNC경고 · CPU(load) · MEM(used%) · [BAT|DKR] · host · 시계 ──
#    SYNC: synchronize-panes(모든 패널 동시입력) 켜졌을 때만 빨갛게 (사고 방지)
#    CPU/MEM 위젯은 OS별 분기 (darwin=sysctl/memory_pressure/pmset · linux=/proc·free·docker)
set -g  status-right-length 160
set -g  status-right '#[fg=#ff5d62,bold]#{?pane_synchronized,SYNC   ,}#[default]'
{{- if eq .chezmoi.os "darwin" }}
set -ga status-right ' #[fg=#727169]CPU#(L=`sysctl -n vm.loadavg | cut -d" " -f2`; N=`sysctl -n hw.ncpu`; I=`echo $L | cut -d. -f1`; if [ ${I:-0} -ge $N ]; then C="#[fg=#ff5d62]"; else C="#[fg=#ffa066]"; fi; echo $C $L)'
set -ga status-right '   #[fg=#727169]MEM#(F=`memory_pressure | grep "free percentage" | grep -Eo "[0-9]+" | tail -1`; U=`expr 100 - ${F:-0}`; if [ $U -ge 90 ]; then C="#[fg=#ff5d62]"; elif [ $U -ge 75 ]; then C="#[fg=#e6c384]"; else C="#[fg=#7aa89f]"; fi; echo $C $U)%%'
{{- if ne .role "server" }}
set -ga status-right '  #(P=`pmset -g batt | grep -i internal | cut -d";" -f1 | grep -Eo "[0-9]+" | tail -1`; A=`pmset -g batt | grep -c "AC Power"`; if [ ${A:-0} -ge 1 ]; then T=AC; else T=BAT; fi; if [ ${P:-100} -le 20 ]; then C="#[fg=#ff5d62]"; elif [ ${P:-100} -le 50 ]; then C="#[fg=#e6c384]"; else C="#[fg=#98bb6c]"; fi; echo $C $T $P)%%'
{{- end }}
{{- else }}
set -ga status-right ' #[fg=#727169]CPU#(L=`cut -d" " -f1 /proc/loadavg`; N=`nproc`; I=`echo $L | cut -d. -f1`; if [ ${I:-0} -ge $N ]; then C="#[fg=#ff5d62]"; else C="#[fg=#ffa066]"; fi; echo $C $L)'
set -ga status-right '   #[fg=#727169]MEM#(T=`grep MemTotal /proc/meminfo | grep -Eo "[0-9]+"`; A=`grep MemAvailable /proc/meminfo | grep -Eo "[0-9]+"`; D=`expr ${T:-1} - ${A:-0}`; U=`expr $D \* 100 / ${T:-1}`; if [ ${U:-0} -ge 90 ]; then C="#[fg=#ff5d62]"; elif [ ${U:-0} -ge 75 ]; then C="#[fg=#e6c384]"; else C="#[fg=#7aa89f]"; fi; echo $C $U)%%'
set -ga status-right '   #[fg=#727169]DKR#(N=`docker ps -q 2>/dev/null | wc -l | tr -d " "`; echo "#[fg=#7aa89f] ${N:-0}")'
{{- end }}
set -ga status-right '   #[fg=#727169]#h'
set -ga status-right '   #[fg=#7e9cd8,bold]%H:%M #[fg=#54546d]%m-%d '

# ── agent 전용 보조 상태줄 ──
# status는 항상 2줄로 고정하고, 두 번째 줄의 내용만 활성 pane이 Claude/Codex일 때 표시한다.
set -g 'status-format[1]' ' #(~/.tmux/codex-statusline "#{pane_current_command}" "#{pane_current_path}" "#{client_width}" "#{pane_pid}" "#{@codex_workdir}")'

# ── 패널 경계 / 메시지 / 카피모드 ──
set -g pane-border-style        "fg=#363646"
set -g pane-active-border-style "fg=#7e9cd8"
set -g message-style            "bg=#7e9cd8,fg=#1f1f28,bold"
set -g mode-style               "bg=#2d4f67,fg=#dcd7ba"

# ============================================================
#  플러그인 (TPM) — 세션 영속(resurrect+continuum)
#  · TPM 설치/플러그인 클론은 chezmoi run_onchange 스크립트가 처리
#  · resurrect: prefix+Ctrl-s 저장 / prefix+Ctrl-r 복원
#  · continuum: 15분 자동저장 + tmux 서버 시작 시 자동복원
#  · 모니터링 세션은 복원 시 프로그램 새로 띄움 = 상태손실 무관(이상적)
# ============================================================
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# 복원 시 다시 띄울 프로그램 화이트리스트 (모니터링 도구들)
set -g @resurrect-processes 'btop htop ctop glances "~lazydocker"'
set -g @resurrect-capture-pane-contents 'on'
set -g @continuum-restore 'on'

# nydus-revive — resurrect 가 저장할 때마다 Claude 세션 원장(창→대화 ID)도 같이 갱신.
#  resurrect 는 @resurrect-processes 화이트리스트만 되살리므로 claude 는 안 살아난다.
#  그 빈칸을 ~/.claude/skills/nydus-revive 가 메우는데, "어느 창이 어느 대화였는지"는
#  살아있을 때 기록해둬야만 정확하다(죽은 뒤 mtime 으로 추측하면 창끼리 뒤바뀐다).
#  🚨 claude 를 @resurrect-processes 에 넣지 말 것 — 빈 대화로 뜨고 이중 실행된다.
#  스킬이 없는 머신에서는 조용히 실패하고 끝난다(무해).
set -g @resurrect-hook-post-save-all '~/.claude/skills/nydus-revive/scripts/nydus_sessions.py snapshot >/dev/null 2>&1'

# TPM 초기화 — 반드시 맨 마지막 줄
run '~/.tmux/plugins/tpm/tpm'
