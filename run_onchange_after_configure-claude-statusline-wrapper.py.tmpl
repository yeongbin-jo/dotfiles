#!/usr/bin/env python3
"""Merge Claude statusLine settings without overwriting the rest of settings.json."""
import json
from pathlib import Path

settings_path = Path.home() / ".claude" / "settings.json"
settings_path.parent.mkdir(parents=True, exist_ok=True)

try:
    settings = json.loads(settings_path.read_text())
    if not isinstance(settings, dict):
        settings = {}
except FileNotFoundError:
    settings = {}
except Exception as exc:
    raise SystemExit(f"[claude-statusline] failed to read {settings_path}: {exc}")

desired = {
    "type": "command",
    "command": str(Path.home() / ".claude" / "statusline-wrapper.sh"),
    "padding": 0,
    "refreshInterval": 1,
}

if settings.get("statusLine") == desired:
    print("[claude-statusline] already configured")
    raise SystemExit(0)

settings["statusLine"] = desired
tmp = settings_path.with_suffix(".json.tmp")
tmp.write_text(json.dumps(settings, ensure_ascii=False, indent=2) + "\n")
tmp.replace(settings_path)
print("[claude-statusline] configured wrapper")
