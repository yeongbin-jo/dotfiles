#!/bin/sh
# dotfiles-sync — public dotfiles 와 private overlay 를 순서대로 최신화·적용한다.
#   1) chezmoi update            (public: git pull + apply)
#   2) private overlay git pull  (~/.local/share/chezmoi-private)
#   3) chezmoi -S <private> apply
# private 이 public 을 덮으므로 항상 이 순서. 둘 중 하나만 apply 하면 역할이 어긋난다.
set -eu
PRIV="${DOTFILES_PRIVATE:-$HOME/.local/share/chezmoi-private}"

echo "== public: chezmoi update =="
chezmoi update "$@"

if [ ! -d "$PRIV/.git" ]; then
  echo "== private overlay 없음: $PRIV ==" >&2
  echo "   git clone git@github.com:yeongbin-jo/dotfiles-private.git \"$PRIV\"  후 다시 실행" >&2
  exit 1
fi
echo "== private: git pull ($PRIV) =="
git -C "$PRIV" pull -q --ff-only
echo "== private: chezmoi -S $PRIV apply =="
chezmoi -S "$PRIV" apply "$@"
echo "== done =="
