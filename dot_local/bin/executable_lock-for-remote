#!/usr/bin/env bash
set -euo pipefail

defaults write com.apple.screensaver askForPassword -int 1
defaults write com.apple.screensaver askForPasswordDelay -int 0
killall cfprefsd >/dev/null 2>&1 || true

agent="$HOME/Library/LaunchAgents/com.yb.keepawake.plist"
if [ -f "$agent" ]; then
  launchctl bootstrap "gui/$(id -u)" "$agent" >/dev/null 2>&1 || true
  launchctl enable "gui/$(id -u)/com.yb.keepawake" >/dev/null 2>&1 || true
  launchctl kickstart -k "gui/$(id -u)/com.yb.keepawake" >/dev/null 2>&1 || true
fi

open -a ScreenSaverEngine >/dev/null 2>&1 || open /System/Library/CoreServices/ScreenSaverEngine.app >/dev/null 2>&1 || true
sleep 1
pmset displaysleepnow

echo "display sleep requested; SSH/Tailscale should remain available while keep-awake is active"
remote-work-status
