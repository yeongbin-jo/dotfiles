#!/usr/bin/env sh
set -eu

# Publish the pane's logical Codex worktree as tmux pane options
# (@codex_workdir / @codex_worktree_name). The tab name itself is governed
# ENTIRELY by tmux.conf's automatic-rename-format, which prefers @codex_workdir
# and falls back to pane_current_path. So this script must NEVER call
# `rename-window` or disable `automatic-rename` — doing so freezes the tab, and
# any out-of-band clearing of the claim would then leave it stuck forever.

workdir="${1:-}"
name="${2:-}"

if [ -z "$workdir" ]; then
  echo "usage: codex-tmux-workdir-set <workdir> [display-name]" >&2
  exit 2
fi

if [ -z "${TMUX:-}" ]; then
  exit 0
fi

if [ -z "$name" ]; then
  name="$(git -C "$workdir" branch --show-current 2>/dev/null || true)"
fi

if [ -z "$name" ]; then
  name="$(basename "$workdir")"
fi

target="${TMUX_PANE:-}"
case "$target" in
  %*) ;;
  "") target="$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)" ;;
  *) target="%$target" ;;
esac

pane_cwd=""
if [ -n "$target" ]; then
  pane_cwd="$(tmux display-message -p -t "$target" '#{pane_current_path}' 2>/dev/null || true)"
fi

if [ -n "$target" ]; then
  if [ "$pane_cwd" = "$workdir" ]; then
    # Shell is physically in the target worktree → no divergent claim needed;
    # automatic-rename-format falls back to the pane cwd on its own.
    tmux set-option -p -q -u -t "$target" @codex_workdir 2>/dev/null || true
    tmux set-option -p -q -u -t "$target" @codex_worktree_name 2>/dev/null || true
  else
    tmux set-option -p -q -t "$target" @codex_workdir "$workdir"
    tmux set-option -p -q -t "$target" @codex_worktree_name "$name"
  fi
else
  tmux set-option -p -q @codex_workdir "$workdir"
  tmux set-option -p -q @codex_worktree_name "$name"
fi
