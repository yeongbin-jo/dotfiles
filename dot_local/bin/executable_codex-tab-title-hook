#!/usr/bin/env python3
"""Keep a tmux tab aligned with the current Codex intent.

UserPromptSubmit asks the already-running Codex turn for a semantic title. A
short-lived watcher applies the first marker quickly; PostToolUse and Stop
hooks reconcile missed or later markers. State is pane-scoped and generation-
scoped so steered prompts that share a Codex turn_id cannot race each other.

The transcript is only a best-effort fast path. Parsing is isolated here and
accepts both the current marker and historical marker variants. Hook failures
never block Codex, but they are recorded in a private local event log.
"""

from __future__ import annotations

from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import time
import unicodedata


MAX_COLUMNS = 24
WATCH_SECONDS = 60
POLL_INITIAL_SECONDS = 0.15
POLL_MAX_SECONDS = 1.0
LOG_MAX_BYTES = 1_000_000
PANE_RE = re.compile(r"^%[0-9]+$")
GENERATION_RE = re.compile(r"^[0-9a-f]{24}$")
HTML_MARKER_RE = re.compile(
    r"<!--\s*codex-tab-title\s*:\s*(.*?)\s*-->", re.I | re.S
)
REFERENCE_LINE_RE = re.compile(
    r"^\[codex-tab-title\]:\s*(.*?)\s*$", re.I | re.M
)
TRAILING_QUOTED_TITLE_RE = re.compile(r'"([^"\r\n]+)"\s*$')

TITLE_CONTEXT = """UI metadata only; this is not a new task. At the very beginning of your first assistant message for this turn (commentary if present, otherwise the final answer), emit exactly one Markdown reference definition in this form:
[codex-tab-title]: <codex-title> "TITLE"
Keep <codex-title> literal and replace only TITLE with a concise 2-6 word summary of the user's current work intent. Name the distinguishing object and action, use the user's language, and keep it within 24 display columns. Preserve the underlying task for status-only follow-ups. Do not change the title for routine phases such as reading, editing, or testing. If the user's dominant intent materially changes later in the same turn, emit one updated reference definition at the beginning of the next assistant commentary. The reference definition is UI metadata and must not be mentioned or explained in visible prose."""


def tmux_binary() -> str | None:
    found = shutil.which("tmux")
    if found:
        return found
    for candidate in ("/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux"):
        if os.access(candidate, os.X_OK):
            return candidate
    return None


def truncate_columns(value: str, limit: int = MAX_COLUMNS) -> str:
    out: list[str] = []
    width = 0
    for char in value:
        char_width = 2 if unicodedata.east_asian_width(char) in {"W", "F"} else 1
        if width + char_width > limit:
            break
        out.append(char)
        width += char_width
    return "".join(out).rstrip(" -_/·:;,.!?|&")


def clean_title(value: str) -> str:
    value = re.sub(r"[\x00-\x1f\x7f]", " ", value)
    value = re.sub(r"[`*_#]", "", value)
    value = re.sub(r"\s+", " ", value).strip(" #\t\r\n-–—:;,.!?")
    if value.lower() in {"title", "codex-title", "<codex-title>"}:
        return ""
    return truncate_columns(value)


def extract_text_marker(text: str) -> str:
    """Return the last valid marker from one assistant message."""
    candidates: list[tuple[int, str]] = []
    for match in HTML_MARKER_RE.finditer(text):
        candidates.append((match.start(), match.group(1)))
    for match in REFERENCE_LINE_RE.finditer(text):
        raw = match.group(1).strip()
        quoted = TRAILING_QUOTED_TITLE_RE.search(raw)
        if quoted:
            raw = quoted.group(1)
        else:
            raw = re.sub(r"^<codex-title>\s*", "", raw, flags=re.I)
        candidates.append((match.start(), raw))
    for _, raw in sorted(candidates, reverse=True):
        title = clean_title(raw)
        if title:
            return title
    return ""


def assistant_texts(item: dict) -> list[str]:
    """Adapt currently observed rollout shapes behind one compatibility seam."""
    texts: list[str] = []
    payload = item.get("payload")
    if not isinstance(payload, dict):
        return texts

    if (
        item.get("type") == "response_item"
        and payload.get("type") == "message"
        and payload.get("role") == "assistant"
    ):
        for content in payload.get("content") or []:
            if isinstance(content, dict) and isinstance(content.get("text"), str):
                texts.append(content["text"])

    completed = payload.get("item") if payload.get("type") == "item_completed" else None
    if isinstance(completed, dict) and completed.get("type") == "AgentMessage":
        for content in completed.get("content") or []:
            if isinstance(content, dict) and isinstance(content.get("text"), str):
                texts.append(content["text"])

    last_message = payload.get("last_agent_message")
    if payload.get("type") == "task_complete" and isinstance(last_message, str):
        texts.append(last_message)
    return texts


def extract_marker(raw_jsonl: str) -> str:
    title = ""
    for raw in raw_jsonl.splitlines():
        try:
            item = json.loads(raw)
        except (TypeError, ValueError):
            continue
        if not isinstance(item, dict):
            continue
        for message in assistant_texts(item):
            candidate = extract_text_marker(message)
            if candidate:
                title = candidate
    return title


def state_path(pane: str) -> Path:
    return Path(tempfile.gettempdir()) / (
        f"codex-tab-title-{os.getuid()}-{tmux_namespace()}-{pane[1:]}.json"
    )


def lock_path(pane: str) -> Path:
    return Path(tempfile.gettempdir()) / (
        f"codex-tab-title-{os.getuid()}-{tmux_namespace()}-{pane[1:]}.lock"
    )


def tmux_namespace() -> str:
    socket = os.environ.get("TMUX", "").split(",", 1)[0]
    return hashlib.sha256(socket.encode()).hexdigest()[:12]


def log_path() -> Path:
    return Path.home() / ".local" / "state" / "codex-tab-title" / "events.jsonl"


@contextmanager
def pane_lock(pane: str):
    path = lock_path(pane)
    with path.open("a+", encoding="utf-8") as handle:
        os.chmod(path, 0o600)
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def read_state(pane: str) -> dict:
    try:
        value = json.loads(state_path(pane).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return value if isinstance(value, dict) else {}


def write_state(pane: str, state: dict) -> None:
    target = state_path(pane)
    fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(state, handle, ensure_ascii=False, separators=(",", ":"))
            handle.write("\n")
        os.replace(temporary, target)
    except Exception:
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def remove_state(pane: str) -> None:
    try:
        state_path(pane).unlink()
    except OSError:
        pass


def log_event(event: str, **details: object) -> None:
    try:
        path = log_path()
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(path.parent, 0o700)
        if path.exists() and path.stat().st_size >= LOG_MAX_BYTES:
            os.replace(path, path.with_suffix(".jsonl.1"))
        record = {
            "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "event": event,
            **details,
        }
        with path.open("a", encoding="utf-8") as handle:
            os.chmod(path, 0o600)
            handle.write(json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n")
    except OSError:
        pass


def tmux_run(*args: str, capture: bool = False) -> subprocess.CompletedProcess[str] | None:
    tmux = tmux_binary()
    if not tmux:
        return None
    try:
        return subprocess.run(
            [tmux, *args],
            check=False,
            text=True,
            stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None


def current_title(pane: str) -> str:
    result = tmux_run("show-options", "-p", "-v", "-t", pane, "@agent_title", capture=True)
    if result is None or result.returncode != 0:
        return ""
    return result.stdout.strip()


def set_title(pane: str, title: str, source: str) -> bool:
    title = clean_title(title)
    if not title:
        return False
    if current_title(pane) == title:
        return True
    result = tmux_run("set-option", "-p", "-t", pane, "@agent_title", title)
    if result is None or result.returncode != 0:
        log_event("tmux_error", pane=pane, operation="set", source=source)
        return False
    refresh = tmux_run("set-window-option", "-t", pane, "automatic-rename", "on")
    if refresh is None or refresh.returncode != 0:
        log_event("tmux_error", pane=pane, operation="refresh", source=source)
        return False
    log_event("title_applied", pane=pane, source=source, title=title)
    return True


def clear_title(pane: str, source: str) -> None:
    tmux_run("set-option", "-p", "-t", pane, "-u", "@agent_title")
    tmux_run("set-window-option", "-t", pane, "automatic-rename", "on")
    log_event("title_cleared", pane=pane, source=source)


def read_complete_jsonl(path: Path, offset: int) -> tuple[str, int]:
    try:
        size = path.stat().st_size
        if size < offset:
            offset = 0
        with path.open("rb") as handle:
            handle.seek(offset)
            raw = handle.read()
    except OSError:
        return "", offset
    last_newline = raw.rfind(b"\n")
    if last_newline < 0:
        return "", offset
    consumed = raw[: last_newline + 1]
    return consumed.decode("utf-8", errors="replace"), offset + len(consumed)


def reconcile(pane: str, source: str, generation: str | None = None, direct_text: str = "") -> bool:
    with pane_lock(pane):
        state = read_state(pane)
        if not state:
            return False
        if generation is not None and state.get("generation") != generation:
            return False

        title = extract_text_marker(direct_text) if direct_text else ""
        transcript_raw = state.get("transcript_path")
        cursor = state.get("cursor", 0)
        if not isinstance(cursor, int) or cursor < 0:
            cursor = 0
        if isinstance(transcript_raw, str) and transcript_raw:
            chunk, cursor = read_complete_jsonl(Path(transcript_raw), cursor)
            state["cursor"] = cursor
            transcript_title = extract_marker(chunk)
            if transcript_title:
                title = transcript_title

        applied = False
        if title:
            applied = set_title(pane, title, source)
            if applied:
                state["title"] = title
                state["applied_at"] = time.time()
        write_state(pane, state)
        return applied


def watch_transcript(pane: str, generation: str) -> int:
    deadline = time.monotonic() + WATCH_SECONDS
    delay = POLL_INITIAL_SECONDS
    while time.monotonic() < deadline:
        state = read_state(pane)
        if state.get("generation") != generation:
            log_event("watcher_invalidated", pane=pane, generation=generation)
            return 0
        if state.get("title"):
            return 0
        if reconcile(pane, "watcher", generation=generation):
            return 0
        state = read_state(pane)
        if state.get("generation") != generation:
            log_event("watcher_invalidated", pane=pane, generation=generation)
            return 0
        time.sleep(delay)
        delay = min(POLL_MAX_SECONDS, delay * 1.5)
    log_event("watcher_timeout", pane=pane, generation=generation)
    return 0


def emit_title_context() -> None:
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "UserPromptSubmit",
                    "additionalContext": TITLE_CONTEXT,
                }
            },
            ensure_ascii=False,
        )
    )


def load_hook_input() -> dict:
    try:
        value = json.load(sys.stdin)
    except Exception:
        return {}
    return value if isinstance(value, dict) else {}


def valid_pane() -> str:
    pane = os.environ.get("TMUX_PANE", "")
    if not os.environ.get("TMUX") or not PANE_RE.fullmatch(pane):
        return ""
    return pane


def begin_prompt(pane: str, data: dict) -> int:
    prompt = str(data.get("prompt") or "").strip()
    if not prompt or prompt.startswith("/"):
        return 0
    transcript_raw = data.get("transcript_path")
    transcript = Path(transcript_raw) if isinstance(transcript_raw, str) and transcript_raw else None
    try:
        offset = transcript.stat().st_size if transcript else 0
    except OSError:
        offset = 0
    generation = secrets.token_hex(12)
    state = {
        "generation": generation,
        "session_id": str(data.get("session_id") or ""),
        "turn_id": str(data.get("turn_id") or ""),
        "transcript_path": str(transcript) if transcript else "",
        "cursor": offset,
        "started_at": time.time(),
    }
    with pane_lock(pane):
        write_state(pane, state)
        if not current_title(pane):
            set_title(pane, "작업 파악 중", "pending")
    subprocess.Popen(
        [sys.executable, __file__, "--watch", pane, generation],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )
    log_event("prompt_started", pane=pane, generation=generation)
    emit_title_context()
    return 0


def invalidate(pane: str, source: str, clear: bool) -> int:
    with pane_lock(pane):
        remove_state(pane)
        if clear:
            clear_title(pane, source)
    return 0


def main() -> int:
    if len(sys.argv) == 4 and sys.argv[1] == "--watch":
        pane, generation = sys.argv[2:]
        if not PANE_RE.fullmatch(pane) or not GENERATION_RE.fullmatch(generation):
            return 0
        return watch_transcript(pane, generation)

    if len(sys.argv) == 2 and sys.argv[1] == "--extract-marker":
        print(extract_marker(sys.stdin.read()))
        return 0

    pane = valid_pane()
    if not pane:
        return 0

    if len(sys.argv) == 2 and sys.argv[1] == "--reconcile":
        data = load_hook_input()
        direct = data.get("last_assistant_message")
        reconcile(
            pane,
            str(data.get("hook_event_name") or "reconcile"),
            direct_text=direct if isinstance(direct, str) else "",
        )
        return 0
    if len(sys.argv) == 2 and sys.argv[1] == "--invalidate":
        load_hook_input()
        return invalidate(pane, "interrupt", clear=False)
    if len(sys.argv) == 2 and sys.argv[1] == "--clear":
        load_hook_input()
        return invalidate(pane, "session_end", clear=True)

    return begin_prompt(pane, load_hook_input())


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as error:
        log_event("uncaught_error", error=type(error).__name__)
        sys.exit(0)
