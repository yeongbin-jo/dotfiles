#!/usr/bin/env bash
# lock-screen — immediately lock the Mac screen behind a password.
#
# Unlike sleeping the display, this does NOT stop any running work: the
# GUI session just switches to the login window while every process keeps
# running (tauri dev, game capture, this ssh session, tailscale, …).
#
# It also ignores the "require password after N seconds" grace delay and
# locks instantly, and it works two ways:
#   • locally, inside your GUI session   → direct login.framework call
#   • over ssh / from a headless shell   → injected into the console user's
#                                          GUI session via `sudo launchctl
#                                          asuser` (needs passwordless sudo)
#
# The screen lock is asynchronous, so after asking for it we poll the
# IOConsoleLocked state for a few seconds before declaring success.
set -euo pipefail

if [ "$(uname)" != "Darwin" ]; then
  echo "lock-screen: macOS only (this host is $(uname))" >&2
  exit 1
fi

login_lib='/System/Library/PrivateFrameworks/login.framework/login'
lock_snippet='import ctypes; ctypes.CDLL("'"$login_lib"'").SACLockScreenImmediate()'

console_user="$(stat -f '%Su' /dev/console 2>/dev/null || echo root)"
console_uid="$(id -u "$console_user" 2>/dev/null || echo 0)"

# Capture ioreg output into a variable and glob-match it, rather than
# piping to `grep -q`: under `set -o pipefail`, grep -q closes the pipe on
# first match and ioreg dies with SIGPIPE, which pipefail would surface as
# a failure even though the pattern matched.
is_locked() {
  local out
  out="$(ioreg -l -w0 2>/dev/null)" || true
  [[ "$out" == *'"IOConsoleLocked" = Yes'* ]]
}

# Poll for the lock to register (it is async); $1 = max seconds to wait.
wait_locked() {
  local n="$1"
  while [ "$n" -gt 0 ]; do
    is_locked && return 0
    sleep 1
    n=$((n - 1))
  done
  is_locked
}

lock_direct() { /usr/bin/python3 -c "$lock_snippet" 2>/dev/null || true; }
lock_asuser() { sudo -n launchctl asuser "$console_uid" /usr/bin/python3 -c "$lock_snippet" 2>/dev/null; }

finish_ok() { echo "locked: screen now requires a password (console user: $console_user)"; exit 0; }

attempted=0

# 1) Local GUI console session → lock directly, no sudo needed.
if [ -z "${SSH_CONNECTION:-}" ] && [ "$(id -u)" = "$console_uid" ]; then
  lock_direct
  attempted=1
  wait_locked 3 && finish_ok
fi

# 2) Over ssh (or if the direct call didn't take) → inject into the
#    console user's GUI session.
if [ "$console_uid" != 0 ]; then
  lock_asuser || true
  attempted=1
  wait_locked 5 && finish_ok
fi

# 3) Console owned by root / nobody logged in → last-resort direct call.
if [ "$attempted" -eq 0 ]; then
  lock_direct
  wait_locked 3 && finish_ok
fi

echo "lock request sent but the screen did not lock" >&2
echo "  no GUI session is logged in, or passwordless sudo is unavailable" >&2
echo "  for 'launchctl asuser $console_uid'." >&2
exit 1
